{
  "name": "meal-prep-from-scratch",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "client"
  ],
  "description": "creating meal plans",
  "license": "ISC",
  "author": "Sravani",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
